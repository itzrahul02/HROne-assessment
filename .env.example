# Dummy values. Copy this file to .env and replace them with your MongoDB URL.
# Variables already set in the environment win over this file.
#
# Local Docker:
#   MONGO_URI=mongodb://localhost:27017
# Atlas (replace the whole URI, including user, password and host):
#   MONGO_URI=mongodb+srv://USER:PASSWORD@your-cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://dummy-user:dummy-password@dummy-host:27017/?retryWrites=true&w=majority
MONGO_DB=attendance_db
